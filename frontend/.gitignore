# ============================================
# Vidhura AI — Frontend Git Ignore Configuration
# ============================================

# ── Dependencies ───────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing & Coverage ─────────────────────
/coverage

# ── Next.js & Build Outputs ────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ── Environment & Secrets ──────────────────
.env
.env.*
.env*.local
!.env.example

# ── Debug Logs ─────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── IDE & Editor Metadata ──────────────────
.vscode
.idea
*.swp
*.swo

# ── Vercel ─────────────────────────────────
.vercel

# ── Platform Artifacts ─────────────────────
.DS_Store
Thumbs.db
*.pem
*.stackdump
