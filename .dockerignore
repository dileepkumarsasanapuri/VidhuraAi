# ============================================
# Vidhura AI — Root Docker Ignore Configuration
# ============================================

# ── Version Control & CI/CD ────────────────
.git
.github

# ── Environment & Local Secrets ────────────
.env
.env.*
.env*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Dependencies ───────────────────────────
node_modules
npm-cache
npm-tmp

# ── Build Artifacts & Caches ───────────────
.next
frontend/.next
out
dist
build
backend/target
**/target
*.class
*.jar
*.war
*.tsbuildinfo

# ── Logs & Debug Files ─────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── IDE & Editor Files ─────────────────────
.vscode
.idea
*.iml
*.ipr
*.iws
*.swp
*.swo

# ── OS & Platform Artifacts ────────────────
.DS_Store
Thumbs.db
*.stackdump

# ── SSL Certificates & Local Keys ──────────
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt
*.pem
*.key

# ── Local & External Policy Storage ────────
policies
manifests
content-addressed
quarantine
data
backend/data
frontend/data
VidhuraData
scratch
backend/scratch
frontend/scratch

# ── Large Downloaded Documents ─────────────
*.pdf
!backend/src/main/resources/evidence/**

# ── Local Database Volumes ─────────────────
mongo-data
*.sqlite
*.db
