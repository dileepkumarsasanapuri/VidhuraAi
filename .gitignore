# ============================================
# Vidhura AI — Root Git Ignore Configuration
# ============================================

# ── Dependencies ───────────────────────────
node_modules/
npm-cache/
npm-tmp/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment & Secrets ──────────────────
# Ignore all .env files and local secret overrides
.env
.env.*
.env*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
# Explicitly protect example configuration templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Build & Compilation Outputs ───────────
.next/
frontend/.next/
dist/
build/
out/
backend/target/
*.class
*.jar
*.war
*.tsbuildinfo
next-env.d.ts

# ── Logs & Debug Artifacts ─────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── IDE & Editor Metadata ──────────────────
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
.classpath
.project
.settings/
.factorypath

# ── Python & Virtual Environments ──────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# ── Testing & Coverage ─────────────────────
coverage/
.nyc_output/

# ── OS & Platform Artifacts ────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.stackdump
*~
*.orig

# ── Local Orchestration Overrides ──────────
docker-compose.override.yml

# ── SSL Certificates & Private Keys ────────
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt
*.pem
*.key

# ── Local & External Policy Storage ────────
# Exclude local download directories and external drives
policies/
manifests/
content-addressed/
quarantine/
data/
backend/data/
frontend/data/
[Ee]:/VidhuraData/
[Ee]:\\VidhuraData\\
VidhuraData/

# ── Policy Documents & Large Blobs ─────────
# Ignore generic PDF downloads and raw blobs
*.pdf
# Explicitly preserve repository test evidence and sample fixtures
!backend/src/main/resources/evidence/**
!backend/src/test/resources/**

# ── Local Scratch & Execution Dumps ────────
scratch/
backend/scratch/
frontend/scratch/
backend-springboot/
.archify/
scripts/*.json
!scripts/reconciled_evidence_ledger.json
scripts/*.py
!scripts/acquire_irdai_policies.py

# ── Sprint & Phase Audit Reports (Root) ─────
# Temporary phase/sprint markdown reports; official docs reside in docs/
/*_report.md
/*_audit.md
/phase*.md
/policy_intelligence_*.md
/recommendation_catalogue_*.md
/vidhura_*.md
!/README.md
!/DEPLOY_AWS.md
!/CI_CD_PIPELINE.md

# ── Local Databases ────────────────────────
*.db
*.sqlite
*.sqlite3
mongo-data/
